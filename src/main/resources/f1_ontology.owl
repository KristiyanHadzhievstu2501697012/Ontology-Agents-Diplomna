    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://f1-strategy.org/ontology#Car -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#Car">
        <rdfs:comment xml:lang="en">Class representing car in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Car</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#Circuit -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#Circuit">
        <rdfs:comment xml:lang="en">Class representing circuit in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Circuit</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#Cloudy -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#Cloudy">
        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#WeatherCondition"/>
        <owl:disjointWith rdf:resource="http://f1-strategy.org/ontology#Rainy"/>
        <owl:disjointWith rdf:resource="http://f1-strategy.org/ontology#Sunny"/>
        <rdfs:comment xml:lang="en">Class representing cloudy in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Cloudy</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#Driver -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#Driver">
        <rdfs:comment xml:lang="en">Class representing driver in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Driver</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#DrivingStylе -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#DrivingStylе">
        <rdfs:comment xml:lang="en">Class representing driving stylе in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">DrivingStylе</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#DryRace -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#DryRace">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://f1-strategy.org/ontology#hasWeather"/>
                <owl:someValuesFrom rdf:resource="http://f1-strategy.org/ontology#Sunny"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#Race"/>
        <owl:disjointWith rdf:resource="http://f1-strategy.org/ontology#WetRace"/>
        <rdfs:comment xml:lang="en">Class representing dry race in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">DryRace</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#DryTrack -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#DryTrack">
        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#TrackCondition"/>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#Hard -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#Hard">
        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#Tyre"/>
        <rdfs:comment xml:lang="en">Class representing hard in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Hard</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#HighSkillDriver -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#HighSkillDriver">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://f1-strategy.org/ontology#Driver"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://f1-strategy.org/ontology#driverSkill"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">90</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#Driver"/>
        <rdfs:comment xml:lang="en">Class representing high skill driver in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">HighSkillDriver</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#Intermediate -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#Intermediate">
        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#Tyre"/>
        <rdfs:comment xml:lang="en">Class representing intermediate in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Intermediate</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#Lap -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#Lap">
        <rdfs:comment xml:lang="en">Class representing lap in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Lap</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#LongRace -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#LongRace">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://f1-strategy.org/ontology#Race"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://f1-strategy.org/ontology#laps"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#Race"/>
        <rdfs:comment xml:lang="en">Class representing long race in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">LongRace</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#Medium -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#Medium">
        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#Tyre"/>
        <rdfs:comment xml:lang="en">Class representing medium in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Medium</rdfs:label>
    </owl:Class>
    


