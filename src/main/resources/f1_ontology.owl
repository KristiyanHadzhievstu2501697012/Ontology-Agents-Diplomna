<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/user/ontologies/2026/3/untitled-ontology-7/"
     xml:base="http://www.semanticweb.org/user/ontologies/2026/3/untitled-ontology-7/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ontology="http://f1-strategy.org/ontology#"
     xmlns:untitled-ontology-7="http://www.semanticweb.org/user/ontologies/2026/3/untitled-ontology-7#">
    <owl:Ontology rdf:about="http://f1-strategy.org/ontology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
