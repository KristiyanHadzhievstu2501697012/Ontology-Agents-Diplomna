        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#Tyre"/>
        <rdfs:comment xml:lang="en">Class representing wet in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Wet</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#WetRace -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#WetRace">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://f1-strategy.org/ontology#hasWeather"/>
                <owl:someValuesFrom rdf:resource="http://f1-strategy.org/ontology#Rainy"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#Race"/>
        <rdfs:comment xml:lang="en">Class representing wet race in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">WetRace</rdfs:label>
    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#WetTrack -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#WetTrack">
        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#TrackCondition"/>
    </owl:Class>
    


