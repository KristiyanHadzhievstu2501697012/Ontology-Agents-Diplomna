     -->

    


    <!-- http://f1-strategy.org/ontology#belongsToTeam -->

    <owl:ObjectProperty rdf:about="http://f1-strategy.org/ontology#belongsToTeam">
        <rdfs:domain rdf:resource="http://f1-strategy.org/ontology#Car"/>
        <rdfs:range rdf:resource="http://f1-strategy.org/ontology#Team"/>
        <rdfs:comment xml:lang="en">Object property representing the relation belongs to team in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">belongsToTeam</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://f1-strategy.org/ontology#drivesCar -->

    <owl:ObjectProperty rdf:about="http://f1-strategy.org/ontology#drivesCar">
