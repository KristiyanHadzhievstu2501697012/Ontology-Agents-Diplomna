        <rdfs:domain rdf:resource="http://f1-strategy.org/ontology#Telemetry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Data property representing tyre wear in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">tyreWear</rdfs:label>
