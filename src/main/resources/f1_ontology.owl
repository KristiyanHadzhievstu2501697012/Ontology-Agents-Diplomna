    </owl:Class>
    


    <!-- http://f1-strategy.org/ontology#Rainy -->

    <owl:Class rdf:about="http://f1-strategy.org/ontology#Rainy">
        <rdfs:subClassOf rdf:resource="http://f1-strategy.org/ontology#WeatherCondition"/>
        <owl:disjointWith rdf:resource="http://f1-strategy.org/ontology#Sunny"/>
        <rdfs:comment xml:lang="en">Class representing rainy in the Formula 1 strategy ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Rainy</rdfs:label>
    </owl:Class>
    


